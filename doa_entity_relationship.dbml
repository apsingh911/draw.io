Table ia_org_hierarchy_master {
  ID bigint [pk]
  NAME varchar(255)
  PARENT_ID int
  TYPE bigint
  OWNER bigint
  REF_ID varchar(255)
  STATUS int
  CREATED_AT datetime
  CREATED_BY bigint
  UPDATED_BY bigint
  UPDATED_AT datetime
}

Table doa_activity_master {
  ID bigint [pk]
  ACTIVITY_NAME varchar(255)
  DEPARTMENT_ID bigint
  ACTIVITY_DESC text
  STATUS int
  CREATED_AT datetime
  CREATED_BY bigint
  UPDATED_BY bigint
  UPDATED_AT datetime
}

Table doa_matrix_library {
  ID bigint [pk]
  TEMPLATE_NAME varchar(255)
  DEPARTMENT_ID bigint
  TEMPLATE_DESC text
  ACTIVITY_ID bigint
  STATUS int
  CREATED_AT datetime
  CREATED_BY bigint
  UPDATED_BY bigint
  UPDATED_AT datetime
}

Table doa_matrix_approval_user {
  ID bigint [pk]
  TEMPLATE_ID bigint
  USER_TYPE varchar(255)
  USER_ID bigint
  PROFILE_ID bigint
  SEQUENCE_ID bigint
  ACTIVITY_ID bigint
  STATUS int
  CREATED_AT datetime
  CREATED_BY bigint
  UPDATED_BY bigint
  UPDATED_AT datetime
}

Table ia_users {
  ID bigint [pk]
  IRM_USER_ID bigint
  PROFILE_ID bigint
  CUST_ID bigint
  IS_ADMIN char(1)
  DESIGNATION varchar(255)
  STATUS int
  CREATED_AT datetime
  CREATED_BY bigint
  UPDATED_BY bigint
  UPDATED_AT datetime
}

Table ia_profile_mst {
  ID bigint [pk]
  PROFILE_NAME varchar(255)
  IS_DELETABLE int
  IS_EDITABLE int
  TYPE int
  STATUS int
  CREATED_AT datetime
  CREATED_BY bigint
  UPDATED_BY bigint
  UPDATED_AT datetime
}


Table delegation_of_authority {
  ID bigint [pk, increment] // Primary Key, Auto Increment
  REFERENCE varchar(255) [not null]
  DEPARTMENT_ID bigint [not null]
  ACTIVITY_ID bigint [not null]
  APPROVAL_STATUS int [not null, default: 0, note: "Width: 1"]
  DOA_STATUS int [not null, default: 0, note: "Width: 1"]
  STATUS int [not null, default: 1, note: "Width: 1"]
  CREATED_BY bigint [null]
  UPDATED_BY bigint [null]
  CREATED_AT datetime [not null]
  UPDATED_AT datetime [not null]
}

Table delegation_of_authority_docs {
  ID bigint [pk, increment] // Primary Key, Auto Increment
  DOA_ID bigint [note: "Foreign key to delegation_of_authority (optional)"]
  DOCSNAME varchar(255) [null]
  FILE_NAME varchar(255) [null]
  ORIGINAL_NAME varchar(255) [null]
  UPLOAD_DATE datetime [not null]
  UPLOAD_BY bigint [null]
  STATUS int [not null, default: 1, note: "Width: 1"]
  CREATED_BY bigint [null]
  UPDATED_BY bigint [null]
  CREATED_AT datetime [not null]
  UPDATED_AT datetime [not null]
}

Table delegation_of_authority_app_logs {
  ID bigint [pk, increment]
  DELEGATION_DETAIL_ID bigint [null]
  USER_TYPE varchar(255) [not null]
  USER_ID bigint [not null]
  ACTIVITY_ID bigint [not null]
  REMARKS text [null, note: "Max length 4000"]
  SEQUENCE int [null]
  IS_COMPLETED int [not null, default: 0, note: "Width: 1"]
  IS_DELEGATE int [not null, default: 0, note: "Width: 1"] // Originally typed as string, fixed to int for consistency
  DELEGATION_REMARK text [null, note: "Max length 4000"]
  DELEGATION_ROLE varchar(255) [null] // Originally typed as number, fixed to varchar for consistency
  DELEGATED_TO bigint [null]
  DUE_DATE datetime [null]
  STATUS int [not null, default: 1, note: "Width: 1"]
  CREATED_BY bigint [null]
  UPDATED_BY bigint [null]
  CREATED_AT datetime [not null]
  UPDATED_AT datetime [not null]
}

ref:delegation_of_authority_app_logs.DELEGATION_DETAIL_ID > delegation_of_authority.ID
ref:delegation_of_authority_app_logs.USER_ID > ia_users.ID
ref:delegation_of_authority_app_logs.ACTIVITY_ID > doa_activity_master.ID

ref:delegation_of_authority_docs.DOA_ID > delegation_of_authority.ACTIVITY_ID

ref: delegation_of_authority.ACTIVITY_ID > doa_activity_master.ID
ref: delegation_of_authority.DEPARTMENT_ID > ia_org_hierarchy_master.ID

Ref: doa_activity_master.DEPARTMENT_ID > ia_org_hierarchy_master.ID

Ref: doa_matrix_library.DEPARTMENT_ID > ia_org_hierarchy_master.ID
Ref: doa_matrix_library.ACTIVITY_ID > doa_activity_master.ID

Ref: doa_matrix_approval_user.TEMPLATE_ID > doa_matrix_library.ID
Ref: doa_matrix_approval_user.ACTIVITY_ID > doa_activity_master.ID
Ref: doa_matrix_approval_user.USER_ID > ia_users.ID

Ref: doa_matrix_approval_user.PROFILE_ID > ia_profile_mst.ID

Ref: ia_users.PROFILE_ID > ia_profile_mst.ID 
